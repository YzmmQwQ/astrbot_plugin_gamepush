{
  "name": "GamePush-Plugin",
  "version": "1.0.13",
  "description": "自动监控游戏版本更新并推送通知，支持Yunzai和Karin",
  "main": "index.js",
  "author": "rainbowwarmth",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "eslint --ext .js,.vue src",
    "format": "prettier --write \"./**/*.{js,vue}\"",
    "fix": "eslint --fix --ext .js && npm run format",
    "install": "pnpx @karinjs/prebuild-install -r napi --target 6 --pkg_version=5.1.7 --pkg_name=sqlite3 && node -e \"const fs = require('fs'); const path = require('path'); if(fs.existsSync('build')) { fs.rmSync(path.join('node_modules', 'sqlite3', 'build'), { recursive: true, force: true }); fs.renameSync('build', path.join('node_modules', 'sqlite3', 'build')); }\""
  },
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/rainbowwarmth/GamePush-Plugin.git"
  },
  "keywords": [],
  "dependencies": {
    "chokidar": "^4.0.3",
    "node-fetch": "^3.3.2",
    "yaml": "^2.8.1",
    "sqlite3": "npm:@karinjs/sqlite3-cjs@0.1.0",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.5.0",
    "eslint-plugin-promise": "^6.6.0",
    "prettier": "^3.6.2"
  },
  "karin": {
    "web": "./web.config.js",
    "apps": [
      "apps"
    ],
    "static": [
      "resources"
    ],
    "files": [
      "config"
    ]
  },
  "imports": {
    "#GamePush.lib": "./lib/index.js",
    "#GamePush.model": "./model/index.js",
    "#GamePush.components": "./components/index.js"
  }
}
